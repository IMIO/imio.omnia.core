<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  i18n_domain="imio.omnia.core">

  <genericsetup:upgradeStep
    title="Register the OAuth 2.0 registry records"
    description="Re-imports the registry step so the new core_auth_type / openai_auth_type / oauth_* records exist, and sets both authentication types to oauth2."
    source="1000"
    destination="1001"
    handler=".upgrades.upgrade_1000_to_1001"
    profile="imio.omnia.core:default"
  />

</configure>
