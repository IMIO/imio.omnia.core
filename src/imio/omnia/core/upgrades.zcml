<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  i18n_domain="imio.omnia.core">

  <genericsetup:upgradeStep
    title="OIA-241: register OAuth2 registry records"
    description="Re-imports the registry step so the new auth_type / oauth_* records exist."
    source="1000"
    destination="1001"
    handler=".upgrades.upgrade_1000_to_1001"
    profile="imio.omnia.core:default"
  />

</configure>
